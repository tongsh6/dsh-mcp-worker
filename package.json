{
  "name": "dsh-mcp-worker",
  "version": "0.9.2",
  "description": "把本机 DSH（DeepSeek Harness）暴露为 MCP worker，供 Claude Code / Codex / ChatGPT 等 leader 调用",
  "type": "module",
  "bin": {
    "dsh-mcp-worker": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx test/mcp-smoke.ts",
    "smoke:http": "tsx test/http-smoke.ts",
    "start": "node dist/index.js",
    "measure:ab": "node scripts/measure-goals.mjs ab",
    "measure:leader": "node scripts/leader-usage.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "mcp:entry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mcp-entry.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "author": "tongsh6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tongsh6/dsh-mcp-worker.git"
  },
  "homepage": "https://github.com/tongsh6/dsh-mcp-worker#readme",
  "bugs": {
    "url": "https://github.com/tongsh6/dsh-mcp-worker/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "dsh",
    "deepseek",
    "claude-code",
    "codex",
    "chatgpt",
    "worker",
    "delegation"
  ],
  "files": [
    "dist"
  ]
}

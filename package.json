{
  "name": "dsh-mcp-worker",
  "version": "0.7.1",
  "private": true,
  "description": "把本机 DSH（DeepSeek Harness）暴露为 MCP worker，供 Claude Code / Codex / ChatGPT 等 leader 调用",
  "type": "module",
  "bin": {
    "dsh-mcp-worker": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx test/mcp-smoke.ts",
    "smoke:http": "tsx test/http-smoke.ts",
    "start": "node dist/index.js",
    "measure:ab": "node scripts/measure-goals.mjs ab",
    "measure:leader": "node scripts/leader-usage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}








